datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPER_STAFF
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  PRODUCT_RECEIVED
  IN_PRODUCTION
  COMPLETED
  READY_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum AttachmentCategory {
  CHALLAN
  DESIGN
  PRODUCT
  DELIVERY
  REFERENCE
  OTHER
}

enum LedgerEntryType {
  RECEIVABLE_ORDER
  RECEIVABLE_INVOICE
  PAYMENT_RECEIVED
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  BKASH
  NAGAD
  OTHER
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  fullName     String
  passwordHash String
  role         Role       @default(STAFF)
  status       UserStatus @default(ACTIVE)
  permissions  String[]   // ["orders:create", "accounts:view", "invoices:create", etc.]
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdOrders   Order[]         @relation("OrderCreatedBy")
  createdExpenses Expense[]       @relation("ExpenseCreatedBy")
  createdAdvances SalaryAdvance[] @relation("AdvanceCreatedBy")
  createdBonuses  EmployeeBonus[] @relation("BonusCreatedBy")
  createdPayments Payment[]       @relation("PaymentCreatedBy")
  createdInvoices Invoice[]       @relation("InvoiceCreatedBy")
  auditLogs       AuditLog[]

  @@index([role, status])
  @@index([username])
}

model Buyer {
  id              String   @id @default(cuid())
  companyName     String   @unique
  contactPerson   String
  phone           String
  altPhone        String?
  email           String?
  address         String
  shippingAddress String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries BuyerLedgerEntry[]

  @@index([companyName])
  @@index([phone])
  @@index([isActive])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // Formatted as YYYYMM0001 (e.g. 2026080001)
  challanNumber        String?     // Single Challan # per order
  buyerId              String
  orderDate            DateTime    @default(now())
  expectedDeliveryDate DateTime?
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal     @default(0) @db.Decimal(12, 2)
  notes                String?
  isArchived           Boolean     @default(false)
  archivedAt           DateTime?
  createdById          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  buyer         Buyer             @relation(fields: [buyerId], references: [id])
  createdBy     User              @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         OrderItem[]
  attachments   OrderAttachment[]
  invoiceOrders InvoiceOrder[]

  @@index([buyerId])
  @@index([status])
  @@index([isArchived])
  @@index([deletedAt])
  @@index([isArchived, deletedAt])
  @@index([orderDate(sort: Desc)])
  @@index([challanNumber])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productType     String   // e.g. Polo T-Shirt, Cap, Kurti, Applique Badge
  styleRef        String?  // Style Ref (e.g. STYLE-901 or —)
  designReference String   // Design Ref / Description (e.g. D-118, D-101, ABC-DESIGN-22)
  quantity        Decimal  @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([designReference])
  @@index([styleRef])
}

model OrderAttachment {
  id         String             @id @default(cuid())
  orderId    String
  imageUrl   String
  publicId   String             // Cloudinary public ID
  category   AttachmentCategory @default(OTHER)
  caption    String?
  width      Int?
  height     Int?
  bytes      Int?
  uploadedAt DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, category])
}

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique // Formatted as YYYY-00001 (e.g. 2026-00001)
  referenceNote   String?        // e.g. "Add reference note"
  buyerId         String
  invoiceDate     DateTime       @default(now())
  subject         String         @default("Bill for Embroidery orders.")
  salutationText  String?        @default("Dear Sir,\nWe are pleased to submit the bill of Embroidery work which done by us. We will be highly Grateful to you if you could make the payments at your earliest.")
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  advanceReceived Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal        @db.Decimal(12, 2)
  inWords         String?        // "Forty Six Thousand Five Hundred Taka Only"
  proprietorName  String         @default("Radwen Hossain")
  notes           String?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  buyer     Buyer          @relation(fields: [buyerId], references: [id])
  createdBy User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  orders    InvoiceOrder[]

  @@index([buyerId])
  @@index([invoiceDate(sort: Desc)])
}

model InvoiceOrder {
  id        String @id @default(cuid())
  invoiceId String
  orderId   String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([invoiceId, orderId])
  @@index([orderId])
}

model BuyerLedgerEntry {
  id              String          @id @default(cuid())
  buyerId         String
  entryDate       DateTime        @default(now())
  entryType       LedgerEntryType
  referenceNumber String?         // e.g. 2026080001 or PAY-2026-0001
  description     String
  debitAmount     Decimal         @default(0) @db.Decimal(12, 2) // Receivable
  creditAmount    Decimal         @default(0) @db.Decimal(12, 2) // Payment
  runningBalance  Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId, entryDate(sort: Desc)])
  @@index([entryDate(sort: Desc)])
  @@index([referenceNumber])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique // e.g. PAY-2026-0001
  buyerId       String
  paymentDate   DateTime      @default(now())
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  referenceNo   String?
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())

  buyer     Buyer @relation(fields: [buyerId], references: [id])
  createdBy User  @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([buyerId])
  @@index([paymentDate(sort: Desc)])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isDefault Boolean   @default(false)
  expenses  Expense[]

  @@index([name])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  categoryId  String
  amount      Decimal         @db.Decimal(12, 2)
  description String
  voucherNo   String?
  createdById String
  createdAt   DateTime        @default(now())

  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([date(sort: Desc)])
  @@index([categoryId, date])
}

model Employee {
  id            String          @id @default(cuid())
  name          String
  phone         String
  address       String
  designation   String
  joiningDate   DateTime
  monthlySalary Decimal         @db.Decimal(12, 2)
  isActive      Boolean         @default(true)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  advances    SalaryAdvance[]
  bonuses     EmployeeBonus[]
  settlements SalaryPayment[]

  @@index([isActive])
}

model SalaryAdvance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @default(now())
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  monthYear   String   // e.g. "2026-08"
  isSettled   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User     @relation("AdvanceCreatedBy", fields: [createdById], references: [id])

  @@index([employeeId, monthYear, isSettled])
}

model EmployeeBonus {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @default(now())
  amount      Decimal  @db.Decimal(12, 2)
  reason      String   // e.g. "Eid Festival Bonus", "Performance Bonus"
  monthYear   String   // e.g. "2026-08"
  createdById String
  createdAt   DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User     @relation("BonusCreatedBy", fields: [createdById], references: [id])

  @@index([employeeId, monthYear])
}

model SalaryPayment {
  id                   String        @id @default(cuid())
  employeeId           String
  monthYear            String        // e.g. "2026-08"
  baseSalary           Decimal       @db.Decimal(12, 2)
  totalBonus           Decimal       @default(0) @db.Decimal(12, 2)
  totalAdvanceDeducted Decimal       @default(0) @db.Decimal(12, 2)
  otherDeductions      Decimal       @default(0) @db.Decimal(12, 2)
  netPaidAmount        Decimal       @db.Decimal(12, 2)
  paymentDate          DateTime      @default(now())
  paymentMethod        PaymentMethod @default(CASH)
  notes                String?
  createdAt            DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, monthYear])
  @@index([monthYear])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. "ORDER_CREATED", "ORDER_ARCHIVED", "PAYMENT_RECORDED"
  module    String   // e.g. "ORDERS", "INVOICES", "BUYERS", "ACCOUNTS", "EMPLOYEES"
  recordId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, createdAt(sort: Desc)])
  @@index([userId])
}

model CompanySetting {
  id             String   @id @default("default")
  companyName    String   @default("New Model Embroidery")
  subtitle       String   @default("( A Computerized Embroidery Project )")
  logoUrl        String?
  phones         String   @default("01731-992361, 01971-992361, 0013472992519")
  email          String   @default("newmodelemb@gmail.com")
  address        String   @default("South Azampur, House 23, R-1, Block-A, Jalal Ahmed Soroni Road, Dhakhin Khan, Dhaka-1230")
  proprietorName String   @default("Radwen Hossain")
  currencySymbol String   @default("৳")
  orderPrefix    String   @default("") // Order format is YYYYMM0001
  invoicePrefix  String   @default("") // Bill format is YYYY-00001
  paymentPrefix  String   @default("PAY-")
  updatedAt      DateTime @updatedAt
}
